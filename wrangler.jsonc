{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bear-construction",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    // Enable Node.js APIs (required for Next.js)
    "nodejs_compat",
    // Allow fetch to public URLs
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match the "name" field above
      "service": "bear-construction"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BEAR_ESTIMATE",
      "id": "b77ba41dfa8542ea9d05cdc4cba67041"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_BOOKING_URL":        "https://go.bearconstruction.co.nz/book",
    "NEXT_PUBLIC_GHL_TRACKING_SRC":   "https://link.contractorscale.com/js/external-tracking.js",
    "NEXT_PUBLIC_GHL_TRACKING_ID":    "tk_bf41288bda444b048916515a9ac962f3",
    "GHL_API_VERSION":                "2021-07-28",
    "GHL_PIT_TOKEN":                  "pit-d8724dd9-2c12-49fa-a10a-c52df0f9933d",
    "GHL_LOCATION_ID":                "fifdlJb4VJ9ykoHVmSar"
  }
}
